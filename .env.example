# Copy to .env and adjust for your VM before `docker compose up --build`.

# Postgres
POSTGRES_DB=fundflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_PORT=5432

# Published ports on the VM host
API_PORT=8080
WEB_PORT=3000

# Browser origins allowed by the API (use your VM IP or domain)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Internal Next.js → API URL (Docker network service name)
INTERNAL_API_URL=http://api:8080

# Security — replace before any shared/production VM
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
PLATFORM_BOOTSTRAP_SECRET=replace-bootstrap-secret

# Seed demo org/users on API startup (set false on real data VMs)
DEV_SEED_ENABLED=true

JAVA_OPTS=-XX:MaxRAMPercentage=75.0
