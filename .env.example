# Copy to .env and adjust before `docker compose up --build`.
# Live stack (DB + API + web): docker compose build && docker compose up -d
# Mock UI only: docker compose -f docker-compose.mock.yml up --build -d

# Postgres
POSTGRES_DB=fundflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Host port for Postgres. Use 5433 if local PostgreSQL already occupies 5432.
POSTGRES_PORT=5433

# Published ports on the VM host
API_PORT=8080
WEB_PORT=3000

# Browser origins allowed by the API (use your VM IP or domain)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Internal Next.js → API URL (Docker network service name)
INTERNAL_API_URL=http://api:8080

# Same secrets as src/test/resources (fine for local Docker; rotate before a shared/production VM)
JWT_SECRET=test-secret-key-must-be-at-least-256-bits-long-for-hs256-algorithm
PLATFORM_BOOTSTRAP_SECRET=test-bootstrap-secret

# Production profile: no demo org/users. Dummy data is the `dev` profile only.
SPRING_PROFILES_ACTIVE=prod
DEV_SEED_ENABLED=false

JAVA_OPTS=-XX:MaxRAMPercentage=75.0
